layout {
    pane split_direction="vertical" size="100%" {
        pane size="45%" name="Editor" focus=true {
            command "bash"
            args "-c" "rm -f /tmp/nvim-zellij.sock && exec nvim --listen /tmp/nvim-zellij.sock"
        }

        pane size="35%" name="Agent" {
            command "agent"
        }

        pane size="20%" name="Terminal"
    }
}
